# OpenClaw workspace .gitignore

# Agent skills installed via npx skills (symlinked, not source)
.agents/

# Node modules
node_modules/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Temp task logs (auto-generated by watchdog system)
logs/tasks/

# Pipeline status files (auto-generated by pipeline monitor)
memory/pipelines/

# Worklog runtime data (ephemeral session continuity)
memory/worklog/

# Cross-agent coordination (private)
coordination/

# SSC/memory-skill scripts (belong in openclaw-skills)
scripts/ssc-*.cjs
scripts/memory-classify.cjs
scripts/pre-compact-guard.cjs
scripts/test-ssc-v4.cjs
